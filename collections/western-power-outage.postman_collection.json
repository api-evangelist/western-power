        {
          "id": "cdd88272-f446-4bc3-b165-6a798f8704b1",
          "name": "Get outage counts for a suburb",
          "request": {
            "name": "Get outage counts for a suburb",
            "description": {
              "content": "Returns a rolled-up outage status for a suburb name — in-flight, resolved and planned counts, affected customers, and a human-readable restoration or planned-outage message. Accepts a comma-separated list, of which the client uses the first value. Unmatched names return zeroed counts with the submitted name title-cased in `suburb`, never an error status.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "status",
                ":suburb"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "suburb",
                  "description": "(Required) Suburb name, e.g. `BOORAGOON`. Case-insensitive."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
