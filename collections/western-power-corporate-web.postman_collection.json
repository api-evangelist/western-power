          "name": "Search westernpower.com.au",
          "request": {
            "name": "Search westernpower.com.au",
            "description": {
              "content": "Full-site search over the corporate site, backed by Optimizely Find. Returns paged `hits`, a `didYouMean` suggestion, facet `types`, and — uniquely — an embedded suburb `outage` rollup so a search box can surface outage status inline. Observed 3,632 total matches for an empty query.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Search term."
                },
                {
                  "disabled": false,
                  "key": "pagenumber",
                  "value": "1",
                  "description": "1-based page index."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Results per page. The site's type-ahead uses 5."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Facet/content-type filter, taken from the `types` array of a prior response."
                },
                {
                  "disabled": false,
                  "key": "includefacets",
                  "value": "<boolean>",
                  "description": "Whether to compute the `types` facet list."
                },
                {
                  "disabled": false,
                  "key": "includeSuburbOutage",
                  "value": "<boolean>",
                  "description": "Whether to populate the embedded `outage` rollup."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
