        {
          "id": "f834c711-82e4-4f0f-b465-477d489c92cf",
          "name": "Query outage area polygons",
          "request": {
            "name": "Query outage area polygons",
            "description": {
              "content": "Standard ArcGIS REST query against layer 0. Supports SQL `where` clauses, attribute selection, spatial filters, ordering, statistics and pagination (`resultOffset` + `resultRecordCount`, `advancedQueryCapabilities.supportsPagination` is true). Page size is capped at 2000 features (32000 with `returnGeometry=false`). Output formats are JSON, geoJSON and PBF.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "0",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "where",
                  "value": "1=1",
                  "description": "SQL-92 where clause. Use `1=1` to select all."
                },
                {
                  "disabled": false,
                  "key": "outFields",
                  "value": "*",
                  "description": "Comma-separated field list, or `*`."
                },
                {
                  "disabled": false,
                  "key": "returnGeometry",
                  "value": "true"
                },
                {
                  "disabled": false,
                  "key": "geometry",
                  "value": "<string>",
                  "description": "Spatial filter geometry (Esri JSON or comma-separated envelope)."
                },
                {
                  "disabled": false,
                  "key": "geometryType",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "spatialRel",
                  "value": "esriSpatialRelIntersects",
                  "description": "Spatial relationship. The layer advertises esriSpatialRelIntersects, Contains, Crosses, EnvelopeIntersects, IndexIntersects, Overlaps, Touches, Within, Disjoint and Relation."
                },
                {
                  "disabled": false,
                  "key": "inSR",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "outSR",
                  "value": "<string>",
                  "description": "Output spatial reference. The layer's native SR is 102100/3857."
                },
                {
                  "disabled": false,
                  "key": "orderByFields",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "returnCountOnly",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "resultOffset",
                  "value": "<integer>",
                  "description": "Pagination offset."
                },
                {
                  "disabled": false,
                  "key": "resultRecordCount",
                  "value": "<integer>",
                  "description": "Page size, capped at 2000 (32000 when returnGeometry=false)."
                },
                {
                  "disabled": false,
                  "key": "f",
                  "value": "json",
                  "description": "Response format. `supportedQueryFormats` is \"JSON, geoJSON, PBF\"."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
